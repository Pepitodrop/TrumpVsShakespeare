# Comma-separated browser origins when the API is hosted separately.
TVS_ALLOWED_ORIGINS=https://game.example.com
TVS_ROOM_TTL_SECONDS=7200
TVS_MAX_ROOMS=1000
TVS_MAX_SOCKETS_PER_ROOM=6
TVS_SOCKET_SEND_TIMEOUT_SECONDS=3
TVS_WS_IDLE_TIMEOUT_SECONDS=60
TVS_WS_MESSAGES_PER_WINDOW=40
TVS_WS_RATE_WINDOW_SECONDS=10
TVS_ENABLE_DOCS=false

# Set this only to the exact reverse-proxy IP or trusted CIDR.
FORWARDED_ALLOW_IPS=127.0.0.1
WS_MAX_SIZE=65536
WS_MAX_QUEUE=16
