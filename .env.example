# Comma-separated browser origins when the API is hosted separately.
TVS_ALLOWED_ORIGINS=https://game.example.com
TVS_ROOM_TTL_SECONDS=7200
TVS_MAX_ROOMS=1000
TVS_ENABLE_DOCS=false

# Set this only to the exact reverse-proxy IP or trusted CIDR.
FORWARDED_ALLOW_IPS=127.0.0.1
WS_MAX_SIZE=65536
WS_MAX_QUEUE=16
